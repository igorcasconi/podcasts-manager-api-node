{
  "name": "podcasts-manager-api-node",
  "version": "1.0.0",
  "description": "podcast manager api with nodejs",
  "license": "ISC",
  "author": "Igor Casconi",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start:dev": "tsx --env-file=.env src/server.ts",
    "start:watch": "tsx watch --env-file=.env src/server.ts",
    "dist": "tsup src",
    "start:dist": "npm run dist && --env-file=.env node/server.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
